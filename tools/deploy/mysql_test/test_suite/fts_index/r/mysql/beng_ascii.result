DROP DATABASE IF EXISTS fts_beng_ascii;
CREATE DATABASE fts_beng_ascii;
USE fts_beng_ascii;
SELECT tokenize('HELLO hello HELLO', 'beng', '[{"output": "all"}]') AS repeated;
repeated
{"tokens": [{"hello": 3}], "doc_len": 3}
SELECT tokenize('hello HELLO', 'beng', '[{"output": "all"}]') AS lowercase_source_key;
lowercase_source_key
{"tokens": [{"hello": 2}], "doc_len": 2}
SELECT tokenize('---HeLLo---', 'beng', '[{"output": "all"}]') AS punctuation;
punctuation
{"tokens": [{"hello": 1}], "doc_len": 1}
SELECT tokenize('Delta alpha delta beta ALPHA!', 'beng', '[{"output": "all"}]') AS order_and_case;
order_and_case
{"tokens": [{"delta": 2}, {"alpha": 2}, {"beta": 1}], "doc_len": 5}
SELECT tokenize('A..B 123 45x _foo_ foo-bar', 'beng', '[{"output": "all"}]') AS ascii_boundaries;
ascii_boundaries
{"tokens": [{"123": 1}, {"bar": 1}, {"45x": 1}, {"foo": 2}], "doc_len": 5}
SELECT tokenize(CONCAT('one', CHAR(9), 'two', CHAR(10), 'three'), 'beng', '[{"output": "all"}]') AS controls;
controls
{"tokens": [{"three": 1}, {"two": 1}, {"one": 1}], "doc_len": 3}
SELECT tokenize(_utf8mb4'Alpha beta alpha' COLLATE utf8mb4_bin, 'beng', '[{"output": "all"}]') AS bin_collation;
bin_collation
{"tokens": [{"beta": 1}, {"alpha": 2}], "doc_len": 3}
SELECT tokenize(_utf8mb4'THE' COLLATE utf8mb4_bin, 'beng', '[{"output": "all"}]') AS bin_stopword;
bin_stopword
{"tokens": [], "doc_len": 0}
SELECT tokenize(_utf8mb4'ARE COM for FROM How THAT the THiS WAS WhAT when WHERE who WILL With UND www ABOUT database' COLLATE utf8mb4_general_ci, 'beng', '[{"output": "all"}]') AS ascii_stopwords;
ascii_stopwords
{"tokens": [{"database": 1}], "doc_len": 1}
SELECT tokenize(BINARY 'Alpha beta alpha', 'beng', '[{"output": "all"}]') AS fallback_collation;
fallback_collation
{"tokens": [{"beta": 1}, {"Alpha": 1}, {"alpha": 1}], "doc_len": 3}
SELECT tokenize('数据库', 'beng', '[{"output": "all"}]') AS non_ascii;
non_ascii
{"tokens": [{"数据库": 1}], "doc_len": 1}
CREATE TABLE beng_reuse (id INT PRIMARY KEY, text_value VARCHAR(100),
                         FULLTEXT INDEX ft_text(text_value) WITH PARSER beng);
INSERT INTO beng_reuse VALUES
  (1, 'Alpha beta'),
  (2, '数据库引擎'),
  (3, 'Gamma delta');
SELECT id FROM beng_reuse WHERE MATCH(text_value) AGAINST('alpha') ORDER BY id;
id
1
SELECT id FROM beng_reuse WHERE MATCH(text_value) AGAINST('数据库引擎') ORDER BY id;
id
2
SELECT id FROM beng_reuse WHERE MATCH(text_value) AGAINST('delta') ORDER BY id;
id
3
DROP TABLE beng_reuse;
DROP DATABASE fts_beng_ascii;
