DROP DATABASE IF EXISTS fts_no_score_count;
CREATE DATABASE fts_no_score_count;
USE fts_no_score_count;
CREATE TABLE docs (id INT PRIMARY KEY, body TEXT,
FULLTEXT INDEX ft(body) WITH PARSER beng);
INSERT INTO docs VALUES
(1, 'database database performance'),
(2, 'database audit'),
(3, 'performance audit'),
(4, 'unrelated document'),
(5, ''),
(6, NULL);
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('database performance');
COUNT(*)
3
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('');
COUNT(*)
0
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('the and');
COUNT(*)
0
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('absentword');
COUNT(*)
0
SELECT COUNT(*) FROM docs
WHERE MATCH(body) AGAINST('database performance') AND id >= 2;
COUNT(*)
2
SELECT GROUP_CONCAT(id ORDER BY id) FROM docs
WHERE MATCH(body) AGAINST('database performance');
GROUP_CONCAT(id ORDER BY id)
1,2,3
SELECT COUNT(*) FROM docs
WHERE MATCH(body) AGAINST('database performance') > 0.1;
COUNT(*)
3
SELECT id, MATCH(body) AGAINST('database performance') AS score
FROM docs WHERE MATCH(body) AGAINST('database performance') ORDER BY id;
id	score
1	1.8299774677192544
2	0.8737369343139607
3	0.8737369343139607
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('+database -audit' IN BOOLEAN MODE);
COUNT(*)
1
PREPARE q FROM 'SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST(?)';
SET @q='database performance';
EXECUTE q USING @q;
COUNT(*)
3
SET @q='';
EXECUTE q USING @q;
COUNT(*)
0
SET @q='audit';
EXECUTE q USING @q;
COUNT(*)
2
DEALLOCATE PREPARE q;
UPDATE docs SET body='database' WHERE id=4;
DELETE FROM docs WHERE id=1;
INSERT INTO docs VALUES (7, 'performance');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('database performance');
COUNT(*)
4
SELECT GROUP_CONCAT(id ORDER BY id) FROM docs
WHERE MATCH(body) AGAINST('database performance');
GROUP_CONCAT(id ORDER BY id)
2,3,4,7
SELECT COUNT(*) FROM (
SELECT id FROM docs WHERE MATCH(body) AGAINST('database performance') LIMIT 2
) limited;
COUNT(*)
2
SELECT COUNT(*) FROM (
SELECT id FROM docs WHERE MATCH(body) AGAINST('database performance') LIMIT 1, 2
) limited_offset;
COUNT(*)
2
DROP DATABASE fts_no_score_count;
